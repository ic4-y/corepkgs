{"version":3,"kind":"Article","sha256":"e1c21a3427f9db5765f763eb23dff2c5c6f453f67b6aff7fda41a25fbefc1347","slug":"building-packages-dependency-failures","location":"/docs/building-packages/dependency-failures.md","dependencies":[],"frontmatter":{"title":"Dependency Failures","content_includes_title":false,"numbering":{"title":{"offset":1}},"exports":[]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"The package you are updating builds fine on its own, but something it depends on\ndoes not.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}}}]},{"type":"heading","depth":2,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"What it looks like","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}}}],"identifier":"what-it-looks-like","label":"What it looks like","html_id":"what-it-looks-like","implicit":true},{"type":"code","lang":"console","value":"error: Build failed due to failed dependency\n\nthese N derivations will be built:\n  /nix/store/...-some-other-package.drv","position":{"start":{"line":8,"column":1},"end":{"line":13,"column":1}}},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"The telling detail is that the error names a ","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}}},{"type":"strong","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"different package","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}}}]},{"type":"text","value":" than the one\nyou set out to update. The failing derivation path in that output is the package\nthat actually broke.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}}}]},{"type":"heading","depth":2,"position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"The fix","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}}}],"identifier":"the-fix","label":"The fix","html_id":"the-fix","implicit":true},{"type":"admonition","kind":"caution","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Caution"}]},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"strong","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"The file you are editing is not the one that is broken.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}}}]},{"type":"text","value":" The ","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}}},{"type":"inlineCode","value":".drv","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}}},{"type":"text","value":" path in\nthe error names the package that broke, and that is the one to repair — editing\nthe package you were updating cannot fix it.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}}}]}]},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Repair the broken dependency, then retry the original update.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}}}]},{"type":"heading","depth":2,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Why it happens","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}}}],"identifier":"why-it-happens","label":"Why it happens","html_id":"why-it-happens","implicit":true},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"A shared dependency was recently updated and broke under it. Or the new version\nadded a dependency that does not build in corepkgs. Or a circular dependency was\nintroduced between two packages that previously did not reference each other.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}}}]},{"type":"heading","depth":2,"position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"What not to do","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}}}],"identifier":"what-not-to-do","label":"What not to do","html_id":"what-not-to-do","implicit":true},{"type":"paragraph","position":{"start":{"line":37,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Reach for ","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}}},{"type":"inlineCode","value":"--impure","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}}},{"type":"text","value":", or skip the sandbox: the failure is a real build failure and\nneither changes it. Remove the dependency from ","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}}},{"type":"inlineCode","value":"buildInputs","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}}},{"type":"text","value":": it is needed, and\nremoving it moves the failure rather than fixing it. Patch the dependent package\nfrom inside the package you were updating: the fix belongs in the package that\nbroke.","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}}}]}]}]},"references":{"cite":{"order":[],"data":{}}},"docs_format":1,"parser_version":"1.9.1"}
